# Copy this file to .env and fill in your key. .env is git-ignored.
# Used server-side only, by the Vite dev-server middleware that backs /api/analyze.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to anthropic/claude-sonnet-5 if unset.
# Any OpenRouter model with vision and structured JSON support works.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
